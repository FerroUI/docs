---
import {topicsFor} from '../data/navigation';
const topics = topicsFor(process.env.DOCS_VERSION || 'next');
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<div class="topic-directory">{topics.map(group=><section id={group.id}><h2>{group.title}</h2><p>{group.description}</p><ul>{group.items.map(([title,slug])=><li><a href={`${base}/${slug}/`}>{title}<span aria-hidden="true">→</span></a></li>)}</ul></section>)}</div>
<style>.topic-directory{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}.topic-directory section{margin:0!important;border:1px solid var(--sl-color-hairline);padding:1.5rem;border-radius:10px;scroll-margin-top:7rem}.topic-directory h2{font-size:1.1rem;margin:0!important;color:var(--sl-color-white)}.topic-directory p{font-size:.85rem;line-height:1.6;margin:.6rem 0 1.2rem}.topic-directory ul{list-style:none;padding:0;margin:0}.topic-directory a{display:flex;justify-content:space-between;gap:1rem;padding:.45rem 0;text-decoration:none;font-size:.85rem}.topic-directory a:hover{text-decoration:underline}.topic-directory a span{color:var(--sl-color-gray-3)}@media(max-width:650px){.topic-directory{grid-template-columns:1fr}}</style>

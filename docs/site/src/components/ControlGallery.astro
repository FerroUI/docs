---
import fs from 'node:fs';
import path from 'node:path';
const controls=JSON.parse(fs.readFileSync(path.resolve(process.cwd(),'public/generated/controls.json'),'utf8'));
const categories=[...new Set(controls.map((c:any)=>c.category))].sort();
---
<control-gallery><div class="gallery-filters"><label><span>Find a control</span><input type="search" placeholder="Button, text, selection…" /></label><label><span>Category</span><select><option value="">All controls</option>{categories.map(category=><option value={String(category)}>{category}</option>)}</select></label></div><p class="gallery-count" role="status">{controls.length} public controls</p><div class="gallery-grid">{controls.map((c:any)=><a href={c.url} data-name={`${c.name} ${c.namespace} ${c.summary}`.toLowerCase()} data-category={c.category}><div class="gallery-card-top"><span>{c.category}</span>{c.live&&<span class="live-badge">● Live example</span>}</div><h3>{c.name}</h3>{c.title!==c.name&&<small>{c.namespace}</small>}<p>{c.summary}</p><span class="gallery-arrow">Explore control →</span></a>)}</div><p data-empty hidden>No matching controls. Try a different name or category.</p></control-gallery>
<script>
class ControlGallery extends HTMLElement {
 connectedCallback(){const search=this.querySelector('input')!,select=this.querySelector('select')!;const filter=()=>{let count=0;for(const card of this.querySelectorAll<HTMLAnchorElement>('[data-name]')){card.hidden=!card.dataset.name!.includes(search.value.toLowerCase())||Boolean(select.value&&card.dataset.category!==select.value);if(!card.hidden)count++}this.querySelector('[role=status]')!.textContent=`${count} matching controls`;(this.querySelector('[data-empty]')as HTMLElement).hidden=count!==0};search.addEventListener('input',filter);select.addEventListener('change',filter)}
}if(!customElements.get('control-gallery'))customElements.define('control-gallery',ControlGallery);
</script>
<style>control-gallery{display:block}.gallery-filters{display:flex;gap:1rem;flex-wrap:wrap}.gallery-filters label{display:flex;flex-direction:column;gap:.4rem;font-size:.72rem;font-weight:500}.gallery-filters label:first-child{flex:1}.gallery-filters input,.gallery-filters select{font:inherit;background:var(--sl-color-bg);color:var(--sl-color-white);border:1px solid var(--sl-color-hairline);border-radius:6px;padding:.65rem}.gallery-count{font-size:.72rem;color:var(--sl-color-gray-3)}.gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1rem}.gallery-grid>a{display:block;text-decoration:none;color:var(--sl-color-text);border:1px solid var(--sl-color-hairline);border-radius:9px;padding:1.2rem}.gallery-grid>a[hidden]{display:none}.gallery-grid>a:hover{border-color:var(--sl-color-accent);background:var(--sl-color-bg-sidebar)}.gallery-card-top{display:flex;gap:.5rem;justify-content:space-between;color:var(--sl-color-gray-3);font-size:.6rem}.live-badge{color:var(--sl-color-accent)}.gallery-grid h3{font-size:1rem;margin:.9rem 0 .6rem;color:var(--sl-color-white)}.gallery-grid p{font-size:.75rem;line-height:1.7;min-height:3.8rem}.gallery-arrow{font-size:.67rem;font-weight:600;color:var(--sl-color-accent)}</style>

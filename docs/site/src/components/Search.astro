---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<docs-search data-base={base} data-version={process.env.DOCS_VERSION || 'next'}>
  <button type="button" class="search-trigger" aria-label="Search documentation"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>Search documentation</span><kbd>⌘ K</kbd></button>
  <dialog aria-label="Search FerroUI documentation"><div class="search-input-row"><input type="search" placeholder="What would you like to build?" aria-label="Search query" autocomplete="off" /><button type="button" data-close aria-label="Close search">Esc</button></div><div class="search-filters"><label>Search in <select data-section><option value="">Everything</option><option value="guides">Application guides</option><option value="controls">Controls</option><option value="api">API reference</option><option value="declarative">Declarative Rust</option><option value="xaml">XAML</option><option value="ecosystem">Ecosystem</option><option value="platforms">Platforms</option><option value="tools">Tools</option></select></label><label><input type="checkbox" data-all /> All versions</label></div><p class="search-status" role="status">Search guides, controls, Rust APIs, and XAML.</p><ol class="search-results"></ol></dialog>
</docs-search>
<script>
  class DocsSearch extends HTMLElement {
    controller = new AbortController();
    engine: any;
    token = 0;
    merged = false;
    timer: ReturnType<typeof setTimeout> | undefined;
    connectedCallback() {
      const signal = this.controller.signal;
      const dialog = this.querySelector('dialog')!;
      const input = this.querySelector<HTMLInputElement>('input[type=search]')!;
      const open = () => { dialog.showModal(); input.focus(); };
      this.querySelector('.search-trigger')!.addEventListener('click', open, { signal });
      this.querySelector('[data-close]')!.addEventListener('click', () => dialog.close(), { signal });
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); }, { signal });
      document.addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dialog.open ? dialog.close() : open(); } }, { signal });
      const search = () => { clearTimeout(this.timer); this.timer = setTimeout(() => this.search(input.value), 160); };
      input.addEventListener('input', search, { signal });
      this.querySelector('[data-section]')!.addEventListener('change', search, { signal });
      this.querySelector('[data-all]')!.addEventListener('change', search, { signal });
      dialog.addEventListener('keydown', (e) => {
        if (!['ArrowDown', 'ArrowUp'].includes(e.key)) return;
        const links = [...this.querySelectorAll<HTMLAnchorElement>('.search-results a')];
        if (!links.length) return; e.preventDefault();
        const current = links.indexOf(document.activeElement as HTMLAnchorElement);
        links[(current + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length]?.focus();
      }, { signal });
    }
    async search(query: string) {
      const token = ++this.token;
      const status = this.querySelector('.search-status')!;
      const list = this.querySelector('.search-results')!;
      if (!query.trim()) { list.replaceChildren(); status.textContent = 'Search guides, controls, Rust APIs, and XAML.'; return; }
      status.textContent = 'Searching…';
      try {
        if (!this.engine) { this.engine = await import(/* @vite-ignore */ `${this.dataset.base}/pagefind/pagefind.js`); await this.engine.init(); }
        const all = this.querySelector<HTMLInputElement>('[data-all]')!.checked;
        if (all && !this.merged) {
          const root = this.dataset.base!.replace(/\/[^/]+$/, '');
          const response = await fetch(`${root}/versions.json`);
          if (response.ok) for (const v of (await response.json()).versions) if (v.id !== this.dataset.version) await this.engine.mergeIndex(`${root}/${v.id}/pagefind/pagefind.js`);
          this.merged = true;
        }
        const section = this.querySelector<HTMLSelectElement>('[data-section]')!.value;
        const filters: Record<string,string> = {};
        if (!all) filters.version = this.dataset.version!;
        if (section) filters.section = section;
        const result = await this.engine.search(query, { filters });
        // Task queries should lead to explanations, rather than be dominated by
        // repeated property names in generated builder/trait reference pages.
        const task = !section && !/::|\(|\)/.test(query)
          ? await this.engine.search(query, { filters: { ...filters, section: ['guides','controls','start','xaml','design','platforms','tools','ecosystem','declarative'] } })
          : null;
        const data = await Promise.all([...(task?.results.slice(0,12) || []), ...result.results.slice(0,35)].map((r: any) => r.data()));
        if (token !== this.token) return;
        const context = (item: any) => new URL(item.url,location.href).pathname.slice(this.dataset.base!.replace(/\/[^/]+$/,'').length+1).split('/');
        const score = (item: any) => {
          const [,kind] = context(item);
          const title = String(item.meta.title || '').toLowerCase();
          const terms=(query.toLowerCase().match(/[a-z0-9]+/g)||[]).map(word=>word.replace(/s$/,''));
          const words=(title.match(/[a-z0-9]+/g)||[]).map(word=>word.replace(/s$/,''));
          const overlap=terms.filter(term=>words.includes(term)).length*3;
          const exact = title === query.toLowerCase() ? 100 : 0;
          const taskWeight = task ? ({guides:30,start:30,xaml:30,design:30,controls:20,platforms:15,ecosystem:15,tools:15,declarative:30} as Record<string,number>)[kind] || 0 : 0;
          return exact + taskWeight + overlap;
        };
        data.sort((a: any,b: any) => score(b)-score(a));
        list.replaceChildren();
        const seen = new Set();
        for (const item of data) {
          if(seen.has(item.url))continue;seen.add(item.url);if(seen.size>25)break;
          const li = document.createElement('li'), a = document.createElement('a'); a.href = item.url;
          if(context(item)[1]==='api'&&/::|_|\(|\)/.test(query))a.href=item.sub_results?.find((sub:any)=>sub.url.includes('#'))?.url||item.url;
          const title = document.createElement('strong'); title.textContent = item.meta.title || item.url;
          const excerpt = document.createElement('p');
          // Pagefind excerpts contain highlighting markup; retain only text and <mark>.
          const parsed = new DOMParser().parseFromString(item.excerpt || '', 'text/html');
          const walk = (node: Node, target: Node) => { for (const c of node.childNodes) { if (c.nodeType === Node.TEXT_NODE) target.appendChild(document.createTextNode(c.textContent || '')); else if ((c as Element).tagName === 'MARK') { const mark = document.createElement('mark'); mark.textContent = c.textContent; target.appendChild(mark); } else walk(c,target); } };
          walk(parsed.body,excerpt); const label=document.createElement('small');const [version,kind]=context(item);label.textContent=`${kind==='api'?'API reference':kind || 'Guide'} · ${version}`; a.append(label,title,excerpt); li.append(a); list.append(li);
        }
        status.textContent = `${result.results.length} results${all ? ' across versions' : ' in ' + this.dataset.version}`;
      } catch { if (token === this.token) status.textContent = 'Search is available in the built site. Run npm run build, then npm run preview.'; }
    }
    disconnectedCallback() { this.controller.abort(); clearTimeout(this.timer); }
  }
  if (!customElements.get('docs-search')) customElements.define('docs-search', DocsSearch);
</script>
<style>
docs-search{display:block;width:100%;max-width:420px}.search-trigger{display:flex;align-items:center;gap:.7rem;width:100%;border:1px solid var(--sl-color-hairline);border-radius:7px;padding:.55rem .7rem;background:var(--sl-color-bg-sidebar);color:var(--sl-color-gray-3);font:inherit;font-size:.75rem;cursor:pointer}.search-trigger kbd{margin-left:auto;font-size:.6rem;border:1px solid var(--sl-color-hairline);border-radius:4px;padding:0 .3rem}dialog{padding:0;border:1px solid var(--sl-color-hairline);background:var(--sl-color-bg);color:var(--sl-color-text);border-radius:12px;width:min(700px,calc(100% - 2rem));max-height:80vh;margin:10vh auto auto;box-shadow:0 20px 80px #0003}dialog::backdrop{background:#0d172970;backdrop-filter:blur(4px)}.search-input-row{display:flex;gap:1rem;padding:1rem;border-bottom:1px solid var(--sl-color-hairline)}.search-input-row input{font:inherit;background:transparent;color:var(--sl-color-white);border:0;outline:0;width:100%;font-size:1rem}.search-input-row button{border:1px solid var(--sl-color-hairline);border-radius:4px;font-size:.65rem;background:transparent;color:inherit}.search-filters{display:flex;justify-content:space-between;gap:1rem;padding:.6rem 1rem;font-size:.7rem}.search-filters select{font:inherit;background:var(--sl-color-bg);color:inherit;border:1px solid var(--sl-color-hairline);border-radius:4px;padding:.2rem}.search-status{font-size:.7rem;color:var(--sl-color-gray-3);padding:.3rem 1rem}.search-results{list-style:none;padding:0;margin:0;max-height:55vh;overflow:auto}.search-results :global(a){display:block;padding:.85rem 1rem;text-decoration:none;color:inherit;border-top:1px solid var(--sl-color-hairline)}.search-results :global(a:hover),.search-results :global(a:focus){background:var(--sl-color-accent-low)}.search-results :global(small){display:block;font-size:.6rem;color:var(--sl-color-gray-3);margin-bottom:.25rem}.search-results :global(strong){color:var(--sl-color-white);font-size:.86rem}.search-results :global(p){font-size:.75rem;margin:.3rem 0 0}.search-results :global(mark){background:var(--sl-color-accent-low);color:var(--sl-color-accent)}@media(max-width:800px){.search-trigger span,.search-trigger kbd{display:none}.search-trigger{width:auto;border:0;background:transparent}docs-search{width:auto}}
</style>

---
import {topicsFor,commonTasks} from '../data/navigation';
const topics = topicsFor(process.env.DOCS_VERSION || 'next');
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<section class="docs-welcome"><div><span class="eyebrow">FERROUI DOCUMENTATION</span><h1>What would you like<br/>to build?</h1><p>Learn the essentials, solve a specific task, or look up a public API.</p><div class="welcome-actions"><a class="primary-link" href={`${base}/start/first-application/`}>Build your first application →</a><a href={`${base}/start/playground/`}>Try live XAML ↗</a></div></div><aside><span class="eyebrow">QUICK LOOKUP</span><a href={`${base}/controls/`}><strong>Find a control →</strong><span>Browse by purpose and try live examples.</span></a><a href={`${base}/api/`}><strong>Look up a Rust API →</strong><span>Public types, members, and crate features.</span></a><a href={`${base}/releases/whats-new/`}><strong>What’s new →</strong><span>Check changes before you upgrade.</span></a></aside></section>
<section class="common-tasks"><div class="section-heading"><h2>I want to…</h2><a href={`${base}/topics/`}>Browse all topics →</a></div><div class="task-grid">{commonTasks.map(([title,slug,description])=><a href={`${base}/${slug}/`}><strong>{title}<span aria-hidden="true">↗</span></strong><span>{description}</span></a>)}</div></section>
<section class="learning-topics"><div class="section-heading"><h2>Explore the documentation</h2><span>From first window to shipping</span></div><div class="topic-cards">{topics.map((group,index)=><a href={`${base}/topics/#${group.id}`}><span class="topic-number">0{index+1}</span><h3>{group.title}</h3><p>{group.description}</p><span class="topic-count">{group.items.length} topics →</span></a>)}</div></section>
<div class="version-notice" hidden role="status"></div>
<script>
const missing=new URLSearchParams(location.search).get('unavailable');const notice=document.querySelector<HTMLElement>('.version-notice');if(missing&&notice){notice.textContent=`“${missing}” is not available in this version. Browse the topics or use search to find an alternative.`;notice.hidden=false;}
</script>
<style>
.docs-welcome{display:grid;grid-template-columns:1.4fr 1fr;gap:4rem;padding:3rem 0;border-bottom:1px solid var(--sl-color-hairline)}.docs-welcome h1{font-size:clamp(2.1rem,4vw,3.4rem);line-height:1.12;color:var(--sl-color-white);margin:.8rem 0 1rem;letter-spacing:-.045em}.docs-welcome p{max-width:32rem;font-size:1rem;line-height:1.7}.welcome-actions{display:flex;align-items:center;gap:1.4rem;flex-wrap:wrap;margin-top:1.5rem;font-size:.85rem}.welcome-actions>a{text-decoration:none}.docs-welcome aside{border:1px solid var(--sl-color-hairline);border-radius:12px;padding:1.4rem 1.6rem;background:var(--sl-color-bg-sidebar);align-self:center}.docs-welcome aside>a{display:block;text-decoration:none;padding:.9rem 0;border-bottom:1px solid var(--sl-color-hairline)}.docs-welcome aside>a:last-child{border:0;padding-bottom:0}.docs-welcome aside strong{display:block;font-size:.9rem;color:var(--sl-color-white)}.docs-welcome aside a>span{display:block;font-size:.8rem;color:var(--sl-color-gray-3);margin-top:.35rem}.section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin:2rem 0 1rem}.section-heading h2{font-size:1.4rem;margin:0!important;color:var(--sl-color-white)}.section-heading>a,.section-heading>span{font-size:.8rem}.section-heading>span{color:var(--sl-color-gray-3)}.task-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem}.task-grid>a{border:1px solid var(--sl-color-hairline);border-radius:8px;padding:1rem;text-decoration:none}.task-grid strong{display:flex;justify-content:space-between;gap:.6rem;color:var(--sl-color-white);font-size:.9rem}.task-grid>a>span{display:block;color:var(--sl-color-gray-3);font-size:.75rem;margin-top:.5rem}.topic-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.topic-cards>a{position:relative;border:1px solid var(--sl-color-hairline);padding:1.4rem;border-radius:9px;text-decoration:none}.topic-number{color:var(--sl-color-accent);font-size:.7rem;font-weight:600}.topic-cards h3{font-size:1rem;margin:.7rem 0;color:var(--sl-color-white)}.topic-cards p{font-size:.85rem;color:var(--sl-color-text);line-height:1.6;margin:0 0 1rem}.topic-count{font-size:.75rem;color:var(--sl-color-accent)}.task-grid>a:hover,.topic-cards>a:hover{border-color:var(--sl-color-accent);background:var(--sl-color-bg-sidebar)}@media(max-width:800px){.docs-welcome{gap:2rem}.task-grid,.topic-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.docs-welcome{grid-template-columns:1fr;padding:1.5rem 0}.task-grid,.topic-cards{grid-template-columns:1fr}.section-heading{flex-wrap:wrap}}
</style>
